# Telemetry configuration for the install stats tooling.
# Copy these values into your shell or adjust as needed before running the scripts.
POKEMMO_TOOL_TELEMETRY_URL=https://telemetry.pokemmo-tool.app/install
POKEMMO_TOOL_TELEMETRY_STATS_URL=https://telemetry.pokemmo-tool.app/stats
# Optional bearer token shared with the telemetry service.
POKEMMO_TOOL_TELEMETRY_KEY=
# Uncomment to disable the GitHub download fallback used by the stats script.
# POKEMMO_TOOL_TELEMETRY_FALLBACK=none
